# Valores comunes del build de producción (este archivo SÍ va en git).
# Lo propio de cada servidor va en .env.production.local (NO va en git y tiene prioridad), por ejemplo:
#   VITE_API_URL=http://192.168.10.101:5200/api
#   PREVIEW_PORT=8080
#   PREVIEW_HOST=true
VITE_BASE=/intrapola/
# URL del backend (Express). Vacío = misma dirección que el frontend (/intrapola/api)
VITE_API_URL=
